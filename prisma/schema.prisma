generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model auto_calculation_rules {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  layout_id          String               @db.Uuid
  target_field_name  String
  formula            String
  description        String?
  is_active          Boolean              @default(true)
  sort_order         Int                  @default(0)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  layouts            layouts              @relation(fields: [layout_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  field_dependencies field_dependencies[]

  @@unique([layout_id, target_field_name], map: "auto_calculation_rules_unique_target")
  @@index([is_active], map: "idx_auto_calculation_rules_active")
  @@index([layout_id], map: "idx_auto_calculation_rules_layout_id")
  @@index([target_field_name], map: "idx_auto_calculation_rules_target_field")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model edge_styles {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String        @db.VarChar(100)
  description         String?
  image               String?       @db.VarChar(255)
  price_per_linear_ft Decimal       @db.Decimal(10, 2)
  thickness           String        @db.VarChar(50)
  is_active           Boolean       @default(true)
  sort_order          Int           @default(0)
  created_at          DateTime?     @default(now()) @db.Timestamp(6)
  updated_at          DateTime?     @default(now()) @db.Timestamp(6)
  quote_items         quote_items[]

  @@index([is_active], map: "idx_edge_styles_is_active")
  @@index([name], map: "idx_edge_styles_name")
  @@index([sort_order], map: "idx_edge_styles_sort_order")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model field_dependencies {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rule_id                String                 @db.Uuid
  source_field_name      String
  dependency_type        String                 @default("input")
  created_at             DateTime?              @default(now()) @db.Timestamp(6)
  auto_calculation_rules auto_calculation_rules @relation(fields: [rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([rule_id], map: "idx_field_dependencies_rule_id")
  @@index([source_field_name], map: "idx_field_dependencies_source_field")
  @@schema("public")
}

model field_group_assignments {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id            String              @db.Uuid
  group_id            String              @db.Uuid
  sort_order          Int                 @default(0)
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  layout_fields       layout_fields       @relation(fields: [field_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  layout_field_groups layout_field_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([field_id, group_id], map: "field_group_assignments_unique")
  @@index([field_id], map: "idx_field_group_assignments_field_id")
  @@index([group_id], map: "idx_field_group_assignments_group_id")
  @@schema("public")
}

model layout_field_groups {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  layout_id               String                    @db.Uuid
  group_name              String
  group_label             String
  sort_order              Int                       @default(0)
  is_visible              Boolean                   @default(true)
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  field_group_assignments field_group_assignments[]
  layouts                 layouts                   @relation(fields: [layout_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([layout_id, group_name], map: "layout_field_groups_unique_name_per_layout")
  @@index([layout_id], map: "idx_layout_field_groups_layout_id")
  @@index([sort_order], map: "idx_layout_field_groups_sort_order")
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model layout_fields {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  layout_id               String                    @db.Uuid
  field_name              String
  field_label             String
  svg_id                  String?
  field_type              String                    @default("manual")
  data_type               String                    @default("measurement")
  unit_type               String                    @default("both")
  is_required             Boolean                   @default(true)
  is_visible              Boolean                   @default(true)
  sort_order              Int                       @default(0)
  validation_rules        Json?
  created_at              DateTime?                 @default(now()) @db.Timestamp(6)
  updated_at              DateTime?                 @default(now()) @db.Timestamp(6)
  field_group_assignments field_group_assignments[]
  layouts                 layouts                   @relation(fields: [layout_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([layout_id, field_name], map: "layout_fields_unique_field_per_layout")
  @@index([field_type], map: "idx_layout_fields_field_type")
  @@index([layout_id], map: "idx_layout_fields_layout_id")
  @@index([sort_order], map: "idx_layout_fields_sort_order")
  @@index([is_visible], map: "idx_layout_fields_visible")
  @@schema("public")
}

model layouts {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  description            String?
  layout_image           String
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  layout_type            String                   @default("standard")
  svg_template_name      String?
  is_active              Boolean                  @default(true)
  sort_order             Int                      @default(0)
  supports_backsplash    Boolean                  @default(false)
  supports_sink          Boolean                  @default(false)
  supports_wall_toggle   Boolean                  @default(false)
  auto_calculation_rules auto_calculation_rules[]
  layout_field_groups    layout_field_groups[]
  layout_fields          layout_fields[]
  quote_items            quote_items[]
  quotes                 quotes[]

  @@schema("public")
}

model leads {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamp(6)
  zipCode    String
  city       String
  name       String
  email      String
  quotes     quotes[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model materials {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplier_id    String?       @db.Uuid
  name           String
  brand          String
  color          String
  variation      String
  thickness      Float
  price_per_sqft Float
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  image          String?
  desc_Curta     String?
  desc_Longa     String?
  product        String?       @default("NULL")
  Seamns         String?       @default("NULL")
  Variation      String?
  Surface        String?       @default("NULL")
  Finish         String?       @default("null")
  Care           String?       @default("NULL")
  Seal           String?       @default("NULL")
  Warranty       String?       @default("NULL")
  Vendor         String?       @default("NULL")
  suppliers      suppliers?    @relation(fields: [supplier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quote_items    quote_items[]
  quotes         quotes[]

  @@schema("public")
}

model sinks {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String?  @db.VarChar
  price       Float?
  environment String?  @db.VarChar
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  asset_url   String?  @db.VarChar

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notifications {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?       @db.Uuid
  message    String
  status     String?       @default("unread")
  created_at DateTime?     @default(now()) @db.Timestamp(6)
  users      public_users? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quote_items {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quote_id          String?      @db.Uuid
  material_id       String?      @db.Uuid
  width_ft          Float
  length_ft         Float
  area_sqft         Float?       @default(dbgenerated("(width_ft * length_ft)"))
  subtotal          Float
  layout_id         String?      @db.Uuid
  edge_style_id     String?      @db.Uuid
  edge_linear_ft    Float?
  edge_cost         Float?
  material_cost     Float?
  cutout_cost       Float?
  sink_cost         Float?
  environment       String?      @db.VarChar(50)
  measurements      Json?
  wall_toggles      Json?
  has_backsplash    Boolean?     @default(false)
  backsplash_height Float?
  cutouts           Json?
  sinks             Json?
  specification     Json?
  edge_styles       edge_styles? @relation(fields: [edge_style_id], references: [id], onUpdate: NoAction)
  layouts           layouts?     @relation(fields: [layout_id], references: [id], onDelete: Cascade)
  materials         materials?   @relation(fields: [material_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotes            quotes?      @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model quotes {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id     String?       @db.Uuid
  total_price Float
  created_at  DateTime?     @default(now()) @db.Timestamp(6)
  layout_id   String?       @db.Uuid
  material_id String?       @db.Uuid
  quote_items quote_items[]
  layouts     layouts?      @relation(fields: [layout_id], references: [id], onDelete: Cascade)
  leads       leads?        @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  materials   materials?    @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

model suppliers {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String?       @unique @db.Uuid
  company_name String
  contact_name String
  phone        String
  email        String        @unique
  materials    materials[]
  users        public_users? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model public_users {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String          @unique
  password      String
  full_name     String
  phone         String?
  role          String
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  notifications notifications[]
  suppliers     suppliers?

  @@map("users")
  @@schema("public")
}
